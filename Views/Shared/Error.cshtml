@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["NoHeader"] = true;
}
<div class="rd-card empty-state mx-auto" style="max-width: 640px;">
    <div class="icon" aria-hidden="true"><i class="bi bi-flag"></i></div>
    <h2 class="mb-2">@Model.Title</h2>
    <p class="text-muted mb-4">@Model.Message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the start line</a>
</div>
