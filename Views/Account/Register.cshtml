@model RegisterViewModel
@{
    ViewData["Title"] = "Create your account";
    ViewData["Subtitle"] = "Join as a participant to enter races, or as an organiser to run them.";
}

<div class="auth-wrap">
    <div class="rd-card rd-card-body">
        <form asp-action="Register" method="post" novalidate data-once>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <fieldset class="mb-4">
                <legend class="form-label fs-6">I want to</legend>
                <div class="role-pick">
                    <label class="cat-option">
                        <input type="radio" asp-for="Role" value="Participant" />
                        <span class="cat-card">
                            <span class="cat-name">Run and race</span>
                            <span class="text-muted small">Browse events, enrol and track my results.</span>
                        </span>
                    </label>
                    <label class="cat-option">
                        <input type="radio" asp-for="Role" value="Organiser" />
                        <span class="cat-card">
                            <span class="cat-name">Organise events</span>
                            <span class="text-muted small">Create events, manage entries, publish results.</span>
                        </span>
                    </label>
                </div>
                <span asp-validation-for="Role" class="text-danger"></span>
            </fieldset>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 8 characters.</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>
    </div>
    <p class="text-center mt-3">Already registered? <a asp-action="Login">Log in</a></p>
</div>
