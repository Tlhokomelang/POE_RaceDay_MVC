@model CategoriesPageViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = "Categories";
    ViewData["Subtitle"] = $"{ev.EventName}, {UiHelpers.ShortDate(ev.EventDate)}. Add age or distance categories participants can enter.";
}
@section HeaderActions {
    <a class="btn btn-outline-light" asp-action="Index" asp-route-eventId="">Change event</a>
    <a class="btn btn-light" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@ev.EventID">Enrolments</a>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="rd-card rd-card-body">
            <h2 class="rd-card-title">Add a category</h2>
            <form asp-action="Add" method="post" novalidate data-once>
                <input type="hidden" asp-for="Form.EventID" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Form.CategoryName" class="form-label"></label>
                    <input asp-for="Form.CategoryName" class="form-control" id="CategoryName" />
                    <div class="d-flex flex-wrap gap-1 mt-2" aria-label="Suggestions">
                        @foreach (var s in new[] { "Under 18", "Open", "Masters 40+", "Veterans 60+", "5 km", "10 km", "21 km" })
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" data-fill-name="@s" data-fill-target="#CategoryName">@s</button>
                        }
                    </div>
                    <span asp-validation-for="Form.CategoryName" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label asp-for="Form.Distance" class="form-label"></label>
                        <input asp-for="Form.Distance" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="Form.Distance" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Form.EntryFee" class="form-label"></label>
                        <input asp-for="Form.EntryFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="Form.EntryFee" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Add category</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="rd-card">
            <div class="panel-head"><h2>Current categories</h2></div>
            @if (!ev.Categories.Any())
            {
                <div class="rd-card-body text-muted">No categories yet. Participants can't enrol until you add at least one.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table">
                        <thead><tr><th scope="col">Category</th><th scope="col">Distance</th><th scope="col">Fee</th><th scope="col">Entered</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                        @foreach (var c in ev.Categories)
                        {
                            <tr>
                                <td><strong>@c.CategoryName</strong></td>
                                <td class="num">@UiHelpers.Km(c.Distance)</td>
                                <td class="num">@UiHelpers.Fee(c.EntryFee)</td>
                                <td class="num">@c.EnrolmentCount</td>
                                <td class="text-end">
                                    <form asp-action="Delete" method="post" class="d-inline" data-confirm="Remove the “@c.CategoryName” category?">
                                        <input type="hidden" name="id" value="@c.CategoryID" />
                                        <input type="hidden" name="eventId" value="@ev.EventID" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(c.EnrolmentCount > 0)">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
