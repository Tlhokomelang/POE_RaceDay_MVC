@model EventListViewModel
@{
    ViewData["Title"] = "Upcoming events";
    ViewData["Subtitle"] = "Find your next start line. Filter by type, place, date or distance.";
}

<form method="get" asp-controller="Home" asp-action="Index" class="rd-card filter-bar mb-4" role="search" aria-label="Filter events">
    <div class="row g-3 align-items-end">
        <div class="col-md-6 col-lg-3">
            <label for="Search" class="form-label">Search</label>
            <input id="Search" name="Search" class="form-control" value="@Model.Filter.Search" placeholder="Event name or keyword" />
        </div>
        <div class="col-md-6 col-lg-2">
            <label for="EventType" class="form-label">Event type</label>
            <select id="EventType" name="EventType" class="form-select">
                <option value="">All types</option>
                @foreach (var type in Model.EventTypes)
                {
                    <option value="@type" selected="@(type == Model.Filter.EventType)">@type</option>
                }
            </select>
        </div>
        <div class="col-md-6 col-lg-2">
            <label for="Location" class="form-label">Location</label>
            <input id="Location" name="Location" class="form-control" value="@Model.Filter.Location" placeholder="City or venue" />
        </div>
        <div class="col-6 col-lg-1">
            <label for="FromDate" class="form-label">From</label>
            <input id="FromDate" name="FromDate" type="date" class="form-control" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-lg-1">
            <label for="ToDate" class="form-label">To</label>
            <input id="ToDate" name="ToDate" type="date" class="form-control" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-lg-1">
            <label for="MaxDistance" class="form-label">Max km</label>
            <input id="MaxDistance" name="MaxDistance" type="number" min="0" step="0.1" class="form-control" value="@Model.Filter.MaxDistance" />
        </div>
        <div class="col-6 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            @if (Model.HasFilter)
            {
                <a class="btn btn-outline-primary" asp-action="Index" asp-route-Search="" aria-label="Clear filters">Clear</a>
            }
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="rd-card empty-state">
        <div class="icon" aria-hidden="true"><i class="bi bi-calendar-x"></i></div>
        <h3>@(Model.HasFilter ? "No events match those filters" : "No upcoming events yet")</h3>
        <p class="text-muted mb-0">@(Model.HasFilter ? "Try widening your search or clearing the filters." : "Check back soon. Organisers are adding events all the time.")</p>
    </div>
}
else
{
    <p class="text-muted" aria-live="polite">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events") found</p>
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-xl-4">
                <partial name="_EventCard" model="ev" />
            </div>
        }
    </div>
}
