@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "Create event";
    ViewData["Subtitle"] = Model.IsEdit ? "Update the details participants see." : "Tell participants what, when and where.";
}
@section HeaderActions {
    <a class="btn btn-outline-light" asp-action="Index">Back to events</a>
}

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.EventID" method="post" enctype="multipart/form-data" novalidate data-once>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="rd-card rd-card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="EventName" class="form-label"></label>
                        <input asp-for="EventName" class="form-control" />
                        <span asp-validation-for="EventName" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="5" maxlength="1000"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="">Choose a type</option>
                            @foreach (var type in Model.EventTypes)
                            {
                                <option value="@type" selected="@(type == Model.EventType)">@type</option>
                            }
                        </select>
                        <span asp-validation-for="EventType" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="rd-card rd-card-body">
                <h3 class="rd-card-title">Banner image</h3>
                <div class="event-banner mb-3 @(string.IsNullOrEmpty(Model.CurrentBanner) ? "is-placeholder" : "")" style="border-radius: 10px;">
                    @if (!string.IsNullOrEmpty(Model.CurrentBanner))
                    {
                        <img src="@UiHelpers.Media(Model.CurrentBanner)" alt="Current banner" />
                    }
                    <img id="bannerPreview" alt="Preview of the new banner" hidden style="position:absolute; inset:0;" />
                </div>
                <label asp-for="Banner" class="form-label"></label>
                <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp,image/gif" data-preview="#bannerPreview" data-warning="#bannerWarning" />
                <div class="form-text">JPG, PNG, WEBP or GIF, up to 5 MB. @(Model.IsEdit ? "Leave empty to keep the current banner." : "")</div>
                <div id="bannerWarning" class="text-danger" role="alert"></div>
                <span asp-validation-for="Banner" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save changes" : "Create event")</button>
        <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
    </div>
</form>
